{
  "manifest_version": 3,
  "name": "Medic-asset",
  "version": "0.1",
  "description": "Détecte les assets cassés et les ouvre dans VS Code",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}